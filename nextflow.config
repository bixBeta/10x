/*
========================================================================================
    10x Nextflow config
========================================================================================
*/

params {

    // ---- Input / output ------------------------------------------------------
    input                   = null      // samplesheet.csv
    outdir                  = './results'
    publish_dir_mode        = 'copy'

    // ---- References ----------------------------------------------------------
    reference               = null      // cellranger transcriptome dir (GEX)
    atac_reference          = null      // cellranger-atac reference dir   (planned)
    arc_reference           = null      // cellranger-arc reference dir    (planned)

    // ---- Cell Ranger runtime options ----------------------------------------
    chemistry               = 'auto'
    expect_cells            = null      // null -> let Cell Ranger estimate
    force_cells             = null
    create_bam              = false     // CR >= 8 requires an explicit choice
    include_introns         = null      // null -> tool default (true on CR >= 7)

    // ---- Container / tool versions -------------------------------------------
    // Pin the Cell Ranger version per run:  --cellranger_version 8.0.1
    // These map to image tags under ghcr.io/${ghcr_owner}/
    ghcr_owner              = 'bixbeta'
    cellranger_version      = '9.0.1'
    cellranger_atac_version = '2.1.0'
    cellranger_arc_version  = '2.0.2'

    // Full image override, wins over the version params above.
    //   --cellranger_container ghcr.io/bixbeta/cellranger:7.2.0
    //   --cellranger_container /shared/sif/cellranger-9.0.1.sif
    cellranger_container      = null
    cellranger_atac_container = null
    cellranger_arc_container  = null

    // ---- Resource ceilings ---------------------------------------------------
    max_cpus                = 32
    max_memory              = '256.GB'
    max_time                = '96.h'

    // ---- Misc ----------------------------------------------------------------
    validate_only           = false     // parse + validate samplesheet, then stop
    help                    = false
}

// ---- Base resources and per-process publishing -------------------------------
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {

    debug {
        cleanup                 = false
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
    }

    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
        apptainer.enabled       = false
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // Cache SIFs outside the work dir so they survive -resume and cleanup
        singularity.cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getProperty('user.home')}/.singularity_cache"
        docker.enabled          = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getProperty('user.home')}/.apptainer_cache"
        docker.enabled          = false
        singularity.enabled     = false
    }

    slurm {
        process.executor        = 'slurm'
        process.queue           = System.getenv('NXF_SLURM_QUEUE') ?: 'normal'
        executor.queueSize      = 20
        executor.submitRateLimit = '10 sec'
    }

    test        { includeConfig 'conf/test.config'       }
    test_multi  { includeConfig 'conf/test_multi.config' }
    test_arc    { includeConfig 'conf/test_arc.config'   }
}

// ---- Containerised runs need the reference dir bound in ----------------------
// Nextflow mounts staged inputs automatically; the reference is passed as a
// staged path so no manual bind is required for either engine.

// ---- Reporting ---------------------------------------------------------------
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_timestamp}.html"      }

manifest {
    name            = '10x'
    author          = 'bixBeta'
    homePage        = 'https://github.com/bixBeta/10x'
    description     = 'Modular Nextflow pipeline for 10x Genomics single-cell data (GEX, with ATAC/ARC to follow)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// ---- Resource ceiling helper (nf-core convention) ----------------------------
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default: $obj"
            return obj
        }
    }
}
