// These params live here rather than in main.nf: nextflow.config is parsed
// before the script, so process directives cannot see script level params.
// 10x software is run from a local install. Give a version and the path is
// built by convention, or give the full path and the version is ignored:
//
//   --crversion  9.0.1   ->  /programs/cellranger-9.0.1/cellranger
//   --arcversion 2.2.0   ->  /programs/cellranger-arc-2.2.0/bin/cellranger-arc
//   --crpath  /some/where/cellranger
//   --programs /opt/apps          ( different site layout )
//
// ---- how 10x software is run -----------------------------------------------
//   --engine singularity   ( default )  run inside a locally built .sif
//   --engine local                      run a native install under --programs
//
// Giving --crpath / --arcpath forces local for that tool, since a binary path
// only makes sense on the host.
params.engine       = "singularity"

params.crversion    = "9.0.1"
params.arcversion   = "2.2.0"

// ---- singularity: images are built locally, never pulled --------------------
// containers/build-sif.sh builds <tool>-<version>.sif from the 10x tarball.
// Cell Ranger is licensed, so these images must not be shared publicly.
params.sifdir       = "/local/workdir/10x_analysis/singularity-sifs"
params.crsif        = null
params.arcsif       = null

// ---- local install ----------------------------------------------------------
params.programs     = "/programs"
params.crpath       = null
params.arcpath      = null

// ---- resolved once, so modules, banner and directives all agree -------------
// cellranger keeps its executable at the top of the install dir, cellranger-arc
// keeps it in bin/. Inside an image both are simply on PATH.
params.crengine     = params.crpath  ? "local" : params.engine
params.arcengine    = params.arcpath ? "local" : params.engine

// file:// makes it explicit that this is a local image and nothing is pulled.
// An absolute path is accepted too; a docker:// uri is passed through as given.
params.crimage      = params.crengine  == "local" ? null : ( params.crsif  ?: "file://${params.sifdir}/cellranger-${params.crversion}.sif" )
params.arcimage     = params.arcengine == "local" ? null : ( params.arcsif ?: "file://${params.sifdir}/cellranger-arc-${params.arcversion}.sif" )

// The filename is only a claim, so the tool is asked its own version inside the
// image before any counting happens. Set false to skip.
params.checkversion = true

// cellranger aggr, for labels that carry several libraries (separate GEM wells).
// --normalize is cellranger's own: mapped subsamples the deeper libraries to
// match the shallowest, none keeps every read.
params.aggr         = true
params.normalize    = "mapped"

params.crbin        = params.crengine  == "local" ? ( params.crpath  ?: "${params.programs}/cellranger-${params.crversion}/cellranger" )        : "cellranger"
params.arcbin       = params.arcengine == "local" ? ( params.arcpath ?: "${params.programs}/cellranger-arc-${params.arcversion}/bin/cellranger-arc" ) : "cellranger-arc"

// kept for compatibility: a full override of the image for either tool
params.container    = params.crimage
params.arccontainer = params.arcimage

params.maxforks     = 2
params.localcores   = 32
params.localmem     = 128           // GB

singularity.enabled     = true
singularity.autoMounts  = true
singularity.runOptions  = "-B /local -B /workdir"


process {

  // Applies to every process. Note maxForks is PER PROCESS, so this is up to
  // 2 concurrent cellranger tasks, i.e. 2 x localcores and 2 x localmem in
  // flight, not 2 tasks across the whole pipeline.
  maxForks = params.maxforks

  errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
  maxRetries    = 2

  // cellranger is told exactly what Nextflow reserved, so --localcores and
  // --localmem cannot drift from the actual allocation
  // container stays unset unless asked for, so the local install under
  // /programs is used and nothing is pulled.
  withName:CELLRANGER_COUNT {
    cpus      = params.localcores
    memory    = "${params.localmem}.GB"
    container = params.container
  }

  withName:CELLRANGER_AGGR {
    cpus      = params.localcores
    memory    = "${params.localmem}.GB"
    container = params.container
  }

  withName:CELLRANGER_ARC_COUNT {
    cpus      = params.localcores
    memory    = "${params.localmem}.GB"
    container = params.arccontainer
  }

  withLabel:process_low {
    cpus   =    2
    memory =    14.GB

  }
  withLabel:process_medium {
    cpus   =    8
    memory =    32.GB

  }
  withLabel:process_high {
    cpus   =    24
    memory =    200.GB

  }

}


workflow.onComplete = {
    // any workflow property can be used here
    println "Pipeline complete"
    println "Command line: $workflow.commandLine"
}

workflow.onError = {
    println "Error: something went wrong"
}
