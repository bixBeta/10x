/*
========================================================================================
    Stub profile covering the tricky grouping cases

        nextflow run . -profile test_multi -stub-run

      sampleA : 1 library,  1 run
      sampleB : 1 library,  2 sequencing runs  -> merged into one count as L001/L002
      sampleC : 2 libraries (separate GEM wells) -> two counts, linked by meta.sample
----------------------------------------------------------------------------------------
*/

// resourceLimits is set here rather than derived from params.max_*: profile
// params are applied after conf/base.config is parsed, so the derived version
// would still carry the full-size defaults.
process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}

params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    input      = "${projectDir}/assets/test_data/samplesheet_multi.csv"
    reference  = "${projectDir}/assets/test_data/ref"
    outdir     = 'results'
}
