/*
========================================================================================
    Base resource requests
========================================================================================
    Cell Ranger count is the heavy step: it wants a lot of RAM and scales to
    ~8-16 cores. Retries bump memory, since OOM is the usual failure mode.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = { check_max( 2                  , 'cpus'   ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h  * task.attempt, 'time'   ) }
    }

    withLabel: process_medium {
        cpus   = { check_max( 6                   , 'cpus'   ) }
        memory = { check_max( 36.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }

    withLabel: process_high {
        cpus   = { check_max( 12                  , 'cpus'   ) }
        memory = { check_max( 72.GB * task.attempt, 'memory' ) }
        time   = { check_max( 16.h  * task.attempt, 'time'   ) }
    }

    // Cell Ranger count / atac count / arc count
    withLabel: process_cellranger {
        cpus   = { check_max( 16                                  , 'cpus'   ) }
        memory = { check_max( 96.GB + (32.GB * (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h  * task.attempt                , 'time'   ) }
    }
}
