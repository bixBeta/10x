/*
========================================================================================
    Minimal stub-run test profile

        nextflow run . -profile test -stub-run

    No real data, no containers. Exercises samplesheet parsing and the GEX path.
    Run assets/test_data/make_test_data.sh first to generate the inputs.
----------------------------------------------------------------------------------------
*/

// resourceLimits is set here rather than derived from params.max_*: profile
// params are applied after conf/base.config is parsed, so the derived version
// would still carry the full-size defaults.
process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}

params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    input      = "${projectDir}/assets/test_data/samplesheet_gex.csv"
    reference  = "${projectDir}/assets/test_data/ref"
    outdir     = 'results'
}
