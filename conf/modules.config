/*
========================================================================================
    Per-process publishing and extra CLI args
========================================================================================
    task.ext.args is the escape hatch for any Cell Ranger flag the pipeline does
    not expose as a param, e.g.:

      process {
          withName: CELLRANGER_COUNT {
              ext.args = '--nosecondary --r1-length 26'
          }
      }
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CELLRANGER_COUNT {
        publishDir = [
            path:   { "${params.outdir}/cellranger/${meta.modality}/${meta.id}" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
