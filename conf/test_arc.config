/*
========================================================================================
    ARC / multiome samplesheet profile

        nextflow run . -profile test_arc --validate_only

    ARC quantification is not implemented yet (v0.3). This profile exists so the
    schema - arc_gex + arc_atac libraries under one sample, fastq_3 required on
    the ATAC side - is parsed and validated from day one.
----------------------------------------------------------------------------------------
*/

// resourceLimits is set here rather than derived from params.max_*: profile
// params are applied after conf/base.config is parsed, so the derived version
// would still carry the full-size defaults.
process {
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}

params {
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '1.h'

    input      = "${projectDir}/assets/test_data/samplesheet_arc.csv"
    outdir     = 'results_arc'
}
