// CI only: keeps singularity.enabled = true from nextflow.config, so a run with
// --crpath / --arcpath proves the native path is NOT containerised. Only the
// small helper process is shrunk to fit the runner.

process {
  withLabel:process_low         { cpus = 1 ; memory = 2.GB }
  withName:CELLRANGER_AGGR      { cpus = 2 ; memory = 4.GB }
}
