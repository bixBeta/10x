# Nextflow
work/
.nextflow/
.nextflow.log*
.nextflow.pid

# Pipeline outputs. Anchored with a leading slash so they match only at the
# repo root: git sets core.ignorecase on macOS, so a bare `CELLRANGER/` also
# excludes modules/cellranger/.
/CELLRANGER/
/CELLRANGER_ARC/
/CELLRANGER_AGGR/
/web_summary_htmls/
/summary_metrics/
/pipeline_info/
report*.html
timeline*.html
trace*.txt
dag*.html

# Generated test inputs (test/make_test_data.sh rebuilds them, CI runs it)
test/Illumina/
test/fastq/
test/ref/
test/refparent/
test/sample-sheet*.csv
test/sheet-*.csv

# Vendor tarballs - 10x binaries must never be committed (EULA).
# Match tarballs only: a rule like `containers/**/cellranger*` would exclude the
# containers/cellranger DIRECTORY, and git will not descend into an excluded
# directory, so a `!...Dockerfile` negation cannot bring the Dockerfiles back.
*.tar.gz
*.tgz

# Singularity images
*.sif
.singularity*/
.apptainer*/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/
