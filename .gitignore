# Nextflow
work/
.nextflow/
.nextflow.log*
.nextflow.pid

# Pipeline outputs
CELLRANGER/
pipeline_info/
report*.html
timeline*.html
trace*.txt
dag*.html

# Generated test inputs
test/fastq/
test/ref/
test/sample-sheet.csv

# Vendor tarballs - 10x binaries must never be committed (EULA).
# Match tarballs only: a rule like `containers/**/cellranger*` would exclude the
# containers/cellranger DIRECTORY, and git will not descend into an excluded
# directory, so a `!...Dockerfile` negation cannot bring the Dockerfiles back.
*.tar.gz
*.tgz

# Singularity images
*.sif
.singularity*/
.apptainer*/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/
